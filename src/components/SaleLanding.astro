---
// Sales landing page for one project I sell: /de-vanzare/<slug>/ and /en/for-sale/<slug>/.
// Content comes from src/data/forsale.js; layout reuses the case study styles plus a few of its own.
import Layout from '../layouts/Layout.astro';
import '../styles/case.css';
import { forSale, saleBase, saleMail } from '../data/forsale.js';
import { num } from '../i18n.js';

const { slug, lang = 'ro' } = Astro.props;
const p = forSale.find(x => x.slug === slug);
const t = p[lang];
const en = lang === 'en';
const base = saleBase[lang];
const cs = en ? `/en/projects/${p.slug}/` : `/proiecte/${p.slug}/`;
const mail = saleMail(t.subject);
const price = p.price ? (en ? `€${num(p.price, lang)}` : `${num(p.price, lang)} €`) : null;
const L = en
  ? { back: '← Projects for sale', sale: 'For sale', priceNone: 'Price on request', priceNote: 'indicative, negotiable', live: 'See it live', case: 'Read the case study', inv: 'Buyers’ page',
      numbers: 'The figures', includes: 'What you get', fit: 'Who it suits', honest: 'Said up front', honestH: 'What you are not buying.', screens: 'What it looks like',
      invH: 'Everything else is on the buyers’ page.', invP: 'Live figures from the production database, screenshots of every account screen, plan prices and a revenue calculator, the technical and legal details, the risks and the transaction terms. The page has a password, which I send by email.', invBtn: 'Open',
      steps: 'How the sale works', stepsH: 'Four steps, no intermediary.', other: 'Other projects for sale', domains: 'Domains for sale', domainsHref: '/en/domains/', withDomain: 'domain included', noDomain: 'without the domain' }
  : { back: '← Proiecte de vânzare', sale: 'De vânzare', priceNone: 'Preț la cerere', priceNote: 'orientativ, negociabil', live: 'Vezi site-ul live', case: 'Citește studiul de caz', inv: 'Pagina pentru cumpărători',
      numbers: 'Cifrele', includes: 'Ce primești', fit: 'Cui i se potrivește', honest: 'Spus de la început', honestH: 'Ce nu cumperi.', screens: 'Cum arată',
      invH: 'Restul e pe pagina pentru cumpărători.', invP: 'Cifrele live din baza de producție, capturi din fiecare ecran al contului, prețurile planurilor și un calculator de venit, detaliile tehnice și juridice, riscurile și termenii tranzacției. Pagina are parolă, pe care ți-o trimit pe email.', invBtn: 'Deschide',
      steps: 'Cum decurge vânzarea', stepsH: 'Patru pași, fără intermediar.', other: 'Alte proiecte de vânzare', domains: 'Domenii de vânzare', domainsHref: '/domenii/', withDomain: 'cu domeniu', noDomain: 'fără domeniu' };
const others = forSale.filter(x => x.slug !== slug);
const shot = src => `${p.shots}/${src}`;
const invHost = p.investors ? p.investors.replace(/^https?:\/\//, '') : '';
const size = (src, w, h) => (w ? { width: w, height: h } : ['judete.jpg', 'collections.jpg', 'service.jpg'].includes(src) ? { width: 1440, height: 1000 } : { width: 1600, height: 962 });
---
<Layout title={t.title} description={t.description} path={`${base}${p.slug}/`} lang={lang} image={p.img} cta={mail} ctaLabel={t.ask}>
  <article class="cs sale">
    <header class="wrap cs-hero sale-hero">
      <a class="cs-back" href={base}>{L.back}</a>
      <div class="sale-grid">
        <div class="sale-copy">
          <p class="label kick">{L.sale} · {t.tag}</p>
          <h1>{t.h1}</h1>
          <p class="lead">{t.lead}</p>
          <div class="btn-row">
            <a class="btn btn-primary btn-lg" href={mail}>{t.ask}</a>
            {p.investors && <a class="btn btn-lg" href={p.investors} target="_blank" rel="noopener">{L.inv}</a>}
            <a class="btn btn-lg" href={p.url} target="_blank" rel="noopener">{L.live}</a>
          </div>
          <p class="sale-cs"><a class="link" href={cs}>{L.case} →</a></p>
        </div>
        <aside class="sale-offer" aria-label={en ? 'The offer in short' : 'Oferta pe scurt'}>
          <p class="label">{p.name} · {p.domain} · {p.withDomain ? L.withDomain : L.noDomain}</p>
          <p class="sale-price">{price ?? L.priceNone}</p>
          {price && <p class="sale-pnote">{L.priceNote}</p>}
          <dl>{t.offer.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
        </aside>
      </div>
    </header>

    <figure class="wrap cs-hero-shot reveal">
      <div class="browser"><span><i></i><i></i><i></i></span><b>{p.domain}</b></div>
      <img src={p.img} alt={`${p.name}: ${t.line}`} width={p.imgW ?? 1440} height={p.imgH ?? (p.slug === 'emud' ? 900 : 1000)}>
    </figure>

    <section class="wrap cs-top is-compact" aria-label={L.numbers}>
      <ul>
        {t.numbers.map(m => (
          <li class="reveal">
            <b data-count={m.value} data-dec="0" data-prefix={m.prefix ?? ''} data-suffix={m.suffix ?? ''}>{(m.prefix ?? '') + num(m.value, lang) + (m.suffix ?? '')}</b>
            <span>{m.label}</span>
          </li>
        ))}
      </ul>
      <p class="small muted">{t.numbersNote}</p>
    </section>

    <section class="wrap cs-sec">
      <div class="cs-side"><p class="label">01 · {L.includes}</p></div>
      <div class="cs-body"><h2>{t.deal}.</h2></div>
    </section>
    <div class="wrap cs-parts sale-parts">
      {t.includes.map(([h, d], i) => (
        <section class="reveal" data-delay={String(i % 2)}>
          <span class="cs-n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{h}</h3>
          <p>{d}</p>
        </section>
      ))}
    </div>

    {t.gallery && (
      <>
        <section class="wrap cs-sec">
          <div class="cs-side"><p class="label">02 · {L.screens}</p></div>
          <div class="cs-body"><h2>{t.line}</h2>{t.galleryNote && <p class="small muted">{t.galleryNote}</p>}</div>
        </section>
        <div class={`wrap sale-gallery${t.phone ? ' has-phone' : ''}`}>
          <div class="cs-pair">
            {t.gallery.map(([src, cap, gw, gh], i) => (
              <figure class="cs-fig reveal" data-delay={String(i % 2)}>
                <img src={shot(src)} alt={cap} {...size(src, gw, gh)} loading="lazy">
                <figcaption>{cap}</figcaption>
              </figure>
            ))}
          </div>
          {t.phone && (
            <figure class="sale-phone reveal">
              <img src={shot(t.phone[0])} alt={t.phone[1]} width="780" height="1620" loading="lazy">
              <figcaption>{t.phone[1]}</figcaption>
            </figure>
          )}
        </div>
      </>
    )}

    <section class="wrap cs-sec">
      <div class="cs-side"><p class="label">03 · {L.fit}</p></div>
      <div class="cs-body">
        <div class="cs-lessons">{t.fit.map(([h, d]) => <div class="reveal"><h3>{h}</h3><p>{d}</p></div>)}</div>
      </div>
    </section>

    <section class="cs-night">
      <div class="wrap">
        <p class="label">04 · {L.honest}</p>
        <h2>{L.honestH}</h2>
        <p class="cs-note">{t.status}</p>
        <ul class="sale-honest">
          {t.honest.map(([h, d]) => <li class="reveal"><b>{h}</b><span>{d}</span></li>)}
        </ul>
      </div>
    </section>

    {p.investors && (
      <section class="wrap sale-inv reveal">
        <div>
          <p class="label kick">{L.inv}</p>
          <h2>{t.invH ?? L.invH}</h2>
          <p>{t.invP ?? L.invP}</p>
        </div>
        <div class="btn-row">
          <a class="btn btn-primary btn-lg" href={mail}>{t.ask}</a>
          <a class="btn btn-lg" href={p.investors} target="_blank" rel="noopener">{L.invBtn} {invHost}</a>
        </div>
      </section>
    )}

    <section class="wrap cs-sec">
      <div class="cs-side"><p class="label">05 · {L.steps}</p></div>
      <div class="cs-body">
        <h2>{L.stepsH}</h2>
        <ol class="cs-steps">
          {t.steps.map(([h, d], i) => (
            <li class="reveal"><span class="cs-v">{String(i + 1).padStart(2, '0')}</span><div><h3>{h}</h3><p>{d}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="wrap"><div class="cs-end">
      <h2>{t.ctaH}</h2>
      <p class="lead">{t.ctaP}</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-lg" href={mail}>{t.ask}</a>
        <a class="btn btn-lg" href={cs}>{L.case}</a>
      </div>
      <p class="sale-more">
        {others.map(o => <a class="link" href={`${base}${o.slug}/`}>{L.other}: {o.name}</a>)}
        <a class="link" href={L.domainsHref}>{L.domains}</a>
      </p>
    </div></section>
  </article>
  <script>import '../scripts/numbers.js';</script>
</Layout>

<style>
  .sale-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(300px, 4fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .sale-hero > .sale-grid { max-width: none; }
  .sale-copy { display: grid; gap: 22px; }
  .sale-copy h1 { max-width: 20ch; }
  .sale-copy .btn-row { margin-top: 6px; }
  .sale-cs { font-size: 16px; }
  .sale-offer { background: var(--night); color: var(--night-ink); border-radius: 18px; padding: clamp(22px, 2.6vw, 32px); display: grid; gap: 6px; }
  .sale-offer .label { color: var(--night-muted); font-size: 13px; }
  .sale-price { font-size: clamp(34px, 4vw, 52px); letter-spacing: -.035em; line-height: 1.05; margin-top: 10px; }
  .sale-pnote { color: var(--night-muted); font-size: 15px; }
  .sale-offer dl { display: grid; margin-top: 18px; border-top: 1px solid var(--night-line); }
  .sale-offer dl div { padding: 12px 0; border-bottom: 1px solid var(--night-line); display: grid; gap: 2px; }
  .sale-offer dt { font: 400 12px/1.4 var(--mono); text-transform: uppercase; letter-spacing: .05em; color: var(--night-muted); }
  .sale-offer dd { margin: 0; font-size: 16px; }
  .sale-parts section { gap: 8px; }
  .sale-gallery { display: grid; gap: 20px; }
  .sale-gallery.has-phone { grid-template-columns: minmax(0, 1fr) clamp(200px, 20vw, 280px); align-items: start; }
  .sale-gallery .cs-fig { margin-top: 0; }
  .sale-gallery .cs-pair { margin-top: clamp(24px, 3vh, 36px); }
  .sale-phone { margin-top: clamp(24px, 3vh, 36px); }
  .sale-phone img { border: 5px solid var(--ink); border-radius: 28px; background: var(--ink); }
  .sale-phone figcaption { margin-top: 10px; font-size: 15px; color: var(--muted); }
  .sale-honest { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; margin-top: 32px; }
  .sale-honest li { display: grid; gap: 6px; padding: 18px 0; border-top: 1px solid var(--night-line); }
  .sale-honest b { font-weight: 500; font-size: 19px; }
  .sale-honest span { color: #c9c9c9; font-size: 16px; max-width: 52ch; }
  .sale-inv { margin-top: clamp(72px, 11vh, 128px); display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px 48px; align-items: end; padding: clamp(24px, 4vw, 48px); border: 1px solid var(--ink); border-radius: 18px; background: #fff; }
  .sale-inv h2 { margin: 12px 0 10px; max-width: 24ch; }
  .sale-inv p:last-child { color: #444; max-width: 62ch; }
  .sale-inv .btn-row { justify-content: flex-end; }
  .sale-more { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 18px; font-size: 16px; color: var(--muted); }
  @media (max-width: 900px) {
    .sale-grid, .sale-inv, .sale-gallery.has-phone { grid-template-columns: 1fr; }
    .sale-honest { grid-template-columns: 1fr; }
    .sale-inv .btn-row { justify-content: flex-start; }
    .sale-phone { max-width: 260px; }
  }
</style>
