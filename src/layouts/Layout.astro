---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';

import { ui, alternate } from '../i18n.js';

const { title, description, path = '/', lang = 'ro', cta, ctaLabel, theme = '', image } = Astro.props;
const t = ui[lang];
const other = alternate(path, lang);
const [ro, en] = lang === 'en' ? [other, path] : [path, other];
const site = 'https://andreinastase.ro';
const canonical = new URL(path, site).href;
const ogImage = new URL(image ?? '/andrei.jpg', site).href;
const nav = t.nav;
const person = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Person', name: 'Andrei Năstase', url: 'https://andreinastase.ro',
  image: 'https://andreinastase.ro/andrei.jpg', jobTitle: t.jobTitle,
  sameAs: ['https://linkedin.com/in/andreinastase', 'https://github.com/andreiandoo'],
});
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang="ro" href={new URL(ro, site).href}>
  <link rel="alternate" hreflang="en" href={new URL(en, site).href}>
  <link rel="alternate" hreflang="x-default" href={new URL(ro, site).href}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ro_RO'}>
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'}>
  <meta name="theme-color" content="#f4f4f3">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script is:inline>document.documentElement.classList.add('js')</script>
  <script is:inline type="application/ld+json" set:html={person}></script>
</head>
<body class={theme}>
  <header class="site-header">
    <div class="wrap">
      <div class="brand-box">
        <a class="brand" href={t.home} aria-label={t.brandLabel}><span class="brand-name">Andrei Năstase</span><i class="brand-dot"></i></a>
      </div>
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav" data-open={t.close} data-closed={t.menu}>{t.menu}</button>
      <nav class="nav" id="nav" aria-label={t.navLabel}>
        {nav.map(([href, label, hot]) => <a href={href} class={hot ? 'hot' : undefined} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
        <a class="lang" href={other} hreflang={lang === 'en' ? 'ro' : 'en'} lang={lang === 'en' ? 'ro' : 'en'} aria-label={t.switchLabel}>{t.switchText}</a>
        <a class="cta" href={cta ?? t.cta[0]}>{ctaLabel ?? t.cta[1]}</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="wrap">
      <span>© {new Date().getFullYear()} Andrei Năstase</span>
      <nav aria-label={t.footLabel}>
        {t.foot.map(([href, label]) => <a href={href}>{label}</a>)}
        <a href="mailto:salut@andreinastase.ro">salut@andreinastase.ro</a>
      </nav>
      <ul class="social">
        <li><a href="https://linkedin.com/in/andreinastase" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></a></li>
        <li><a href="https://github.com/andreiandoo" target="_blank" rel="noopener" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.82.58A12 12 0 0 0 12 .3z"/></svg></a></li>
        <li><a href="https://www.facebook.com/sinecvanon/" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.03 4.39 11.03 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg></a></li>
        <li><a href="https://www.instagram.com/sinecvanon/" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.03.08C5.76.14 4.89.34 4.13.64c-.79.31-1.46.72-2.12 1.38C1.34 2.69.94 3.36.63 4.15c-.29.76-.49 1.63-.55 2.9C.03 8.33.01 8.74.01 12s.02 3.67.08 4.95c.06 1.27.26 2.14.55 2.9.31.79.72 1.46 1.38 2.12.67.67 1.34 1.07 2.13 1.38.76.29 1.63.49 2.9.55 1.28.05 1.69.07 4.95.07s3.67-.02 4.95-.08c1.27-.06 2.14-.26 2.9-.55a5.9 5.9 0 0 0 2.12-1.38 5.9 5.9 0 0 0 1.38-2.13c.29-.76.49-1.63.55-2.9.05-1.28.07-1.69.07-4.95s-.02-3.67-.08-4.95c-.06-1.27-.26-2.14-.55-2.9a5.9 5.9 0 0 0-1.38-2.12A5.9 5.9 0 0 0 19.85.63c-.76-.29-1.63-.49-2.9-.55C15.67.03 15.26.01 12 .01S8.33.03 7.03.08zM12 5.84a6.16 6.16 0 1 1 0 12.32 6.16 6.16 0 0 1 0-12.32zm0 2.16a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm6.4-3.84a1.44 1.44 0 1 1 0 2.88 1.44 1.44 0 0 1 0-2.88z"/></svg></a></li>
      </ul>
    </div>
  </footer>
  <script>import '../scripts/site.js'; import '../scripts/life.js';</script>
</body>
</html>
