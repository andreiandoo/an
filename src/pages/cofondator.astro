---
import Layout from '../layouts/Layout.astro';
import Process from '../components/Process.astro';
import { founderSteps } from '../data/portfolio.js';
import body from '../partials/cofondator.html?raw';

const [a, b] = body.split('<!--process-->');
---
<Layout
  title="Cofondator tehnic pentru ideea ta de produs | Andrei Năstase"
  description="Ai o idee de produs și oameni care o așteaptă, îți lipsește cine să o construiască. Pornim împreună o firmă nouă: construiesc produsul pentru o parte din ea, sau la preț redus și o parte mai mică."
  path="/cofondator/"
  cta="#idee"
  ctaLabel="Spune-mi ideea"
>
  <Fragment set:html={a} />
  <Process title="Cum decurge" id="decurge" steps={founderSteps} />
  <Fragment set:html={b} />
</Layout>
