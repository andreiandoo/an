---
import CaseStudy from '../../components/CaseStudy.astro';

// Figures checked on 5 Nov 2026: git history of resources/marketplaces/viaqui in the ePAS repo, the data files,
// viaqui.com and its sitemaps. The attraction pages are informational; booking goes through partners for now.
const cs = {
  title: 'Viaqui: studiu de caz | Andrei Năstase',
  description: 'Cum am construit Viaqui în 11 zile: 113.093 de atracții din 51 de țări europene, din date deschise, cu 17 monede, hărți, trasee și un planificator de călătorie.',
  path: '/proiecte/viaqui/',
  shots: '/shots/viaqui',
  label: 'Studiu de caz · 2026',
  h1: 'Viaqui: 113.093 de atracții din Europa, pornite de la un site românesc, în 11 zile.',
  lead: 'Un site în engleză pentru călători: ce merită văzut în fiecare oraș european, pe hartă, în trasee și într-un plan de călătorie. A pornit ca o copie a bilete.online, generalizată pentru mai multe țări, monede și limbi.',
  summary: ['Voiam să văd cât de repede devine bilete.online un produs pentru toată Europa.', '113.093 de atracții din 51 de țări, din date deschise, cu 17 monede, hărți, trasee și un planificator.', 'Public după trei zile, terminat în 11, cu 80 de commit-uri. Deocamdată câștigă din recomandările către parteneri.'],
  facts: [
    ['Rol', 'Fondator. Produs, design, cod, date'],
    ['Perioadă', '6 - 16 octombrie 2026'],
    ['Stare', 'Live pe viaqui.com din 8 octombrie'],
    ['Construit pe', 'ePAS, pornind din codul bilete.online'],
  ],
  links: [{ href: 'https://viaqui.com', text: 'viaqui.com' }, { href: 'https://viaqui.com/map/italy', text: 'Harta Italiei' }],
  hero: { src: 'home.jpg', alt: 'Pagina principală Viaqui: Experiences begin before you arrive', domain: 'viaqui.com' },
  top: [
    { value: 113093, label: 'atracții în catalog' },
    { value: 51, label: 'de țări europene' },
    { value: 17, label: 'monede de afișare' },
    { value: 11, label: 'zile, de la primul la ultimul commit' },
  ],
  topNote: 'Atracțiile sunt numărate în fișierele de date din repo; restul de pe site și din git, pe 5 noiembrie 2026.',
  blocks: [
    {
      label: '01 · Ideea', h2: 'Același produs, dar pentru toată Europa.',
      ps: [
        'bilete.online avea deja harta, traseele, planificatorul și panoul pentru operatori, dar doar pentru România și doar în română. Am vrut să văd cât de repede poate deveni același cod un produs internațional.',
        'Răspunsul: 80 de commit-uri în 11 zile. Pe 8 octombrie site-ul era public și indexabil.',
      ],
    },
    { type: 'pair', items: [
      { src: 'rome.jpg', alt: 'Pagina orașului Roma pe Viaqui: Things to do in Rome', cap: 'Pagina unui oraș: atracții cu încărcare continuă, experiențe de la parteneri, zboruri și servicii de călătorie.' },
      { src: 'colosseum.jpg', alt: 'Pagina atracției Colosseum pe Viaqui', cap: 'Pagina unei atracții: descriere din Wikidata, poze din Wikimedia Commons, cu autorul și licența.' },
    ] },
    {
      type: 'steps', label: '02 · Cele 11 zile', h2: 'Cum a crescut, zi cu zi.',
      items: [
        { v: '6 oct.', t: 'Copia și scheletul în engleză', d: 'Am pornit de la codul bilete.online: interfață în engleză, 12 categorii, locurile Europei din GeoNames, pagini de țară și de oraș, prețuri în euro.' },
        { v: '7 oct.', t: 'Toate atracțiile', d: 'Atracțiile din Wikidata pentru 50 de țări, cu descriere, date, insignă UNESCO și vecinii cei mai apropiați. Hărți pe țări, 16 trasee, planificator pe țară, experiențe de la parteneri, zboruri, sitemap-uri.' },
        { v: '8 oct.', t: 'Monede, limbi, lansare', d: 'Vizitatorul își alege moneda. Toate textele trec printr-un strat de traducere, inclusiv panoul pentru operatori. Am automatizat trimiterea paginilor către motoarele de căutare și am deschis site-ul.' },
        { v: '9-16 oct.', t: 'Viteză și indexare', d: 'Runde de PageSpeed, date de modificare reale în sitemap, cod 503 în loc de 404 când platforma din spate e ocupată, descrieri proprii pentru fiecare pagină.' },
      ],
    },
    {
      type: 'flow', label: '03 · Datele', h2: 'Doar date deschise, cu sursa scrisă pe pagină.',
