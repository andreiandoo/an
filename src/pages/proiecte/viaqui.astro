      nodes: [
        { t: 'GeoNames', items: ['51 de țări, 585 de regiuni', '9.038 de orașe peste 10.000 de locuitori', 'Licență CC BY 4.0'] },
        { t: 'Wikidata', items: ['113.093 de atracții în 50 de fișiere', 'Descrieri, coordonate, UNESCO', 'Licență CC0'] },
        { t: 'Wikimedia Commons', items: ['Poze afișate de la sursă, la 960 px', 'Autorul și licența, păstrate', 'Pagină de credite foto'] },
        { t: 'ePAS și site-ul', items: ['Seeder idempotent în platformă', '161 de fișiere statice pentru hărți și planificator', 'Pagini servite din cache'], accent: true },
      ],
      foot: 'Germania are cele mai multe atracții (16.834), urmată de Italia (15.471), Franța (12.428), Spania (12.302) și Regatul Unit (9.736).',
    },
    { type: 'pair', items: [
      { src: 'map.jpg', alt: 'Harta atracțiilor din Italia pe Viaqui', cap: 'Harta unei țări: 15.471 de atracții în Italia, grupate pe zone.' },
      { src: 'plan.jpg', alt: 'Planificatorul Viaqui: A trip through Italy', cap: 'Planificatorul pe țară: de unde pleci, câte zile, cu ce mergi.' },
    ] },
    {
      type: 'parts', label: '04 · Componente', h2: 'Ce am adăugat peste bilete.online.',
      items: [
        { t: 'Monede', d: 'Prețul apare în moneda țării, iar filtrele compară în euro.', items: ['17 monede la alegerea vizitatorului', 'Cursuri zilnice, cu tabel de rezervă', 'Cache de pagină separat pentru fiecare monedă', 'Curs BCE în platformă pentru prețurile operatorilor'] },
        { t: 'Limbi', d: 'Catalogul e deocamdată în engleză, dar codul e pregătit pentru oricare limbă.', items: ['Fiecare text trece prin funcția de traducere', 'Același strat și în JavaScript', 'Prefixul de limbă se adaugă la linkuri automat', 'Câmp de limbă pe fiecare marketplace din ePAS'] },
        { t: 'Parteneri', d: 'Până apar operatorii, banii vin din recomandări către parteneri de călătorie.', items: ['Tururi audio, zboruri, transferuri, eSIM, mașini', 'Un singur punct de ieșire, cu listă de domenii permise', 'Scripturile partenerilor, doar după acordul de marketing', 'Atribuire pe tip de pagină și pe oraș'] },
        { t: 'Indexare', d: 'Aproape 140.000 de pagini trebuie găsite de motoarele de căutare.', items: ['Sitemap-uri împărțite pe țări, sub limita de 50.000', 'Data reală a ultimei modificări, luată din git', 'IndexNow și Search Console, zilnic, automat', 'Categoriile goale nu se indexează'] },
      ],
    },
    { type: 'fig', src: 'routes.jpg', alt: 'Traseele Viaqui prin Europa', cap: '17 trasee prin Europa, de la castelele Rinului la catedralele Siciliei.' },
    {
      type: 'metrics', label: '05 · Metrici', h2: 'Ce am numărat.',
      note: 'Măsurat în repo și în sitemap-urile live, pe 5 noiembrie 2026. Paginile de atracție sunt informative: biletele se cumpără deocamdată prin parteneri.',
      items: [
        ['113.093', 'atracții, suma celor 50 de fișiere pe țări', 'măsurat'],
        ['129.840', 'adrese în sitemap-urile de atracții și liste pe orașe', 'măsurat'],
        ['9.087', 'pagini de locuri: țări, regiuni, orașe', 'măsurat'],
        ['53', 'de sitemap-uri, cel mai mare cu circa 17.500 de adrese', 'măsurat'],
        ['80', 'de commit-uri în 11 zile', 'git'],
        ['0,24 s', 'timpul de răspuns al paginii principale, o singură măsurătoare', 'măsurat'],
      ],
      build: [['224', 'fișiere PHP'], ['68k', 'linii de PHP'], ['161', 'fișiere de date pentru hărți'], ['23 MB', 'date despre Europa'], ['17', 'trasee'], ['12', 'categorii']],
    },
    {
      type: 'lessons', label: '06 · Ce am învățat', h2: 'Ce iau cu mine.',
      items: [
        ['Generalizează a doua oară, nu prima', 'bilete.online a fost scris pentru o singură țară. Abia când am avut nevoie de a doua am știut ce trebuie scos în configurare: moneda, limba, sursa de date.'],
        ['Data falsă din sitemap strică totul', 'Dacă toate paginile spun că s-au schimbat azi, motorul de căutare nu mai crede niciuna. Data vine acum din istoricul git al fiecărui fișier.'],
        ['Când platforma din spate nu răspunde, spune-o corect', 'Un 404 scoate pagina din index. Un 503 cere doar să revină mai târziu.'],
        ['O decizie de produs se poate schimba de două ori în trei zile', 'Euro peste tot, apoi moneda țării, apoi la alegerea vizitatorului. Fiecare variantă a fost ieftin de testat pentru că prețul trece printr-un singur loc.'],
      ],
    },
    {
      label: '07 · Unde e acum', h2: 'Un catalog european, deocamdată în engleză.',
      ps: ['Toate textele trec deja prin stratul de traducere, dar singura limbă publicată e engleza. Coșul, plata și panoul de operator sunt pregătite, însă pe 5 noiembrie 2026 sitemap-ul nu avea încă nicio experiență de vânzare directă. Până atunci, Viaqui câștigă din recomandările către parteneri.'],
    },
  ],
};
---
<CaseStudy cs={cs} />
