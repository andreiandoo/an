---
import CaseStudy from '../../components/CaseStudy.astro';

// Client project for Teach for Romania. Figures checked on 5 Nov 2026 in the local copy (theme, plugins, dev database
// structure of 17 Sep 2026; no git history) and on the staging site. No pupil or teacher data is shown or counted
// beyond reference data; the staging copy's usage figures are not repeated because they could not be verified.
const cs = {
