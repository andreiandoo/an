      ],
    },
    { type: 'fig', src: 'categorie.jpg', alt: 'Categoria Muzee și expoziții în România pe bilete.online', cap: 'O categorie: muzee și expoziții, cu filtre, text pentru căutări și hartă.' },
    {
      type: 'metrics', label: '06 · Metrici', h2: 'Ce am numărat.',
      note: 'Toate cifrele sunt măsurate în repo sau pe site, pe 5 noiembrie 2026. Site-ul nu are încă trafic sau vânzări pe care să le pot publica.',
      items: [
        ['7.954', 'atracții în catalog: 7.275 din importul inițial și 681 de monumente din Wikidata', 'măsurat'],
        ['341', 'de orașe, în 8 regiuni', 'de pe site'],
        ['12', 'categorii de experiențe', 'de pe site'],
        ['~3%', 'mărimea unei miniaturi față de poza originală', 'măsurat'],
        ['0,3 s', 'timpul de răspuns al paginii principale, o singură măsurătoare', 'măsurat'],
        ['55 + 41', 'pagini pentru vizitatori și pentru operatori', 'în cod'],
      ],
      build: [['205', 'fișiere PHP'], ['52k', 'linii de PHP'], ['89', 'fișiere CSS'], ['191', 'machete de design'], ['14', 'servicii noi în ePAS'], ['~25', 'migrații în ePAS']],
    },
    {
      type: 'lessons', label: '07 · Ce am învățat', h2: 'Ce iau cu mine.',
      items: [
        ['O platformă comună scurtează lansarea', 'Plățile, biletele, emailurile și panoul de admin existau deja în ePAS. Am construit doar ce era nou: activitățile, harta și planificatorul.'],
        ['Modulele noi nu au voie să atingă clienții vechi', 'Fiecare funcție nouă e pornită doar pentru clientul care o folosește, iar platforma refuză cererile de la ceilalți.'],
        ['Datele statice bat API-ul la volum mare', 'Harta cu aproape 8.000 de puncte se încarcă dintr-un singur fișier JSON, generat la build. Nu face câte un apel pentru fiecare punct.'],
        ['Spune ce e estimat', 'Planificatorul nu are orele de vizitare ale fiecărui muzeu. Folosește durate pe tip de atracție și scrie asta chiar pe pagină.'],
      ],
    },
    {
      label: '08 · Unde e acum', h2: 'Catalogul e mare. Biletele de vânzare sunt încă puține.',
      ps: ['Toate cele 7.954 de atracții au pagină, poze și loc pe hartă, dar biletele se pot cumpăra doar pentru experiențele adăugate de operatori, iar acestea sunt deocamdată câteva. Paginile atracțiilor nu sunt încă în sitemap. Panoul de operator, plata și biletele cu QR funcționează și așteaptă mai mulți parteneri.'],
    },
    {
      label: '09 · Mai departe', h2: 'Am clonat site-ul pentru Europa în 11 zile.',
