      nodes: [
        { t: 'ePAS (Laravel)', items: ['Atracții, experiențe, locații', 'Comenzi, bilete cu QR, plăți', 'Panou Filament comun tuturor site-urilor'] },
        { t: 'API marketplace', items: ['Cheie separată pentru fiecare site', 'Module pornite doar pentru clientul lor', 'Limită de 120 de cereri pe minut'] },
        { t: 'Cache pe două niveluri', items: ['Răspunsuri API, servite și când expiră', 'Pagini întregi, gata generate', 'Cereri paralele cu curl_multi'], accent: true },
        { t: 'Vizitatorul', items: ['Pagini HTML rapide, în spatele Cloudflare', 'Hartă și planificator din fișiere statice', 'Plata trimisă înapoi în ePAS'] },
      ],
      foot: 'Modulele noi, ca activitățile cu sloturi orare, sunt pornite doar pentru bilete.online. AmBilet, care rulează pe aceeași platformă, nu le vede.',
