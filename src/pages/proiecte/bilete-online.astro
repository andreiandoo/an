---
import CaseStudy from '../../components/CaseStudy.astro';

// Figures checked on 5 Nov 2026: git history of resources/marketplaces/bileteonline in the ePAS repo, the code,
// the two attraction CSVs and bilete.online. The 7,954 attractions are an informational catalogue, not bookable stock.
const cs = {
  title: 'bilete.online: studiu de caz | Andrei Năstase',
  description: 'Cum am construit bilete.online: atracții, muzee și experiențe din toată România, cu hartă interactivă, trasee și un planificator de excursii, pe aceeași platformă ca Tixello și AmBilet.',
  path: '/proiecte/bilete-online/',
  shots: '/shots/bileteonline',
  label: 'Studiu de caz · 2026',
  h1: 'bilete.online: 7.954 de locuri de văzut în România, pe o hartă, cu bilet de pe telefon.',
  lead: 'Un marketplace pentru atracții, muzee, parcuri și experiențe din toată țara. Alegi ziua, plătești online și intri cu codul QR de pe telefon. Pe lângă bilete, site-ul te ajută să alegi: hartă, trasee și un planificator de excursii.',
  summary: ['Biletele la muzee și atracții se cumpără în multe locuri, iar informația despre ce merită văzut e împrăștiată.', 'Un marketplace pe ePAS, cu 7.954 de atracții pe hartă, 37 de trasee, un planificator de excursii și un panou pentru operatori.', 'Live pe bilete.online. Catalogul e complet, dar biletele se vând deocamdată doar pentru câteva experiențe adăugate de operatori.'],
