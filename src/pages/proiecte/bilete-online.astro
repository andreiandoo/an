      { src: 'harta.jpg', alt: 'Harta atracțiilor din România pe bilete.online, cu grupuri de puncte pe fiecare zonă', cap: 'Harta: toate atracțiile, încărcate dintr-un singur fișier static, fără câte un apel pentru fiecare punct.' },
      { src: 'traseu.jpg', alt: 'Traseul Drumul castelelor din Transilvania pe hartă, cu opririle în ordine', cap: 'Un traseu: Drumul castelelor din Transilvania, cu opriri, distanțe și timp de mers.' },
    ] },
