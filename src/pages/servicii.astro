---
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/Pricing.astro';
import Process from '../components/Process.astro';
import Chaos from '../components/Chaos.astro';
import Exploded from '../components/Exploded.astro';
import { steps } from '../data/portfolio.js';
import body from '../partials/servicii.html?raw';

const cut = body.indexOf('</section>') + '</section>'.length;
const [a, rest] = body.slice(cut).split('<!--pricing-->');
const [b, c] = rest.split('<!--process-->');
---
<Layout
  title="Aplicații web și mobile pentru firme | Andrei Năstase"
  description="Vă spun sincer ce merită construit în firma voastră: o aplicație web sau mobilă, o automatizare sau nimic nou. Web de la 3.000 €, mobil de la 5.000 €."
  path="/servicii/"
  cta="#cerere"
>
  <Fragment set:html={body.slice(0, cut)} />
  <section class="ribbon" id="ribbon" aria-hidden="true"><canvas></canvas></section>
  <Fragment set:html={a} />
  <Chaos />
  <Exploded />
  <Pricing third="audit" contact="#cerere" />
  <Fragment set:html={b} />
  <Process steps={steps} intro="De la primul apel la aplicația folosită de echipa voastră, știți mereu unde suntem." />
  <Fragment set:html={c} />
  <script>import '../scripts/ribbon.js';</script>
</Layout>
