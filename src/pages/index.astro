---
import fs from 'node:fs';
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/Pricing.astro';
import Process from '../components/Process.astro';
import { products, inWork, roles, clients, numbers, skills, socials, steps } from '../data/portfolio.js';
import rest from '../partials/home-rest.html?raw';

const has = path => fs.existsSync(`public/shots/${path}.jpg`);
const first = ['Fiskl', 'SICAR Museum', 'PerformanceHR', 'EuroSpirit', 'ACS Arhivarul'];
const rank = c => (first.includes(c.name) ? first.indexOf(c.name) : first.length);
const list = clients.filter(c => has(`clients/${c.file}`)).sort((a, b) => rank(a) - rank(b));
const older = clients.filter(c => !has(`clients/${c.file}`));
const cats = [...new Set(list.map(c => c.cat))];
const [restA, restB] = rest.split('<!--pricing-->');
const [restC, restD] = restB.split('<!--process-->');
const hero = [['tixello', 'a'], ['dreamsatlas', 'b'], ['tics', 'c']];
const format = m => `${m.prefix ?? ''}${m.value.toLocaleString('ro-RO', { maximumFractionDigits: m.dec ?? 0, minimumFractionDigits: m.dec ?? 0 })}${m.suffix ?? ''}`;
const metric = (name, label) => format(numbers.find(n => n.name === name).metrics.find(m => m.label === label));
const ledger = [
  ['#proiecte', String(products.length), 'produse proprii'],
  ['.nums li:nth-child(1)', metric('Tixello', 'procesați'), 'procesați prin Tixello'],
  ['.nums li:nth-child(2)', metric('AmBilet', 'medie pe 5 luni'), 'vânzări AmBilet, medie pe 5 luni'],
  ['.nums li:nth-child(3)', metric('Dreams Atlas', 'afișări organice'), 'afișări organice, Dreams Atlas'],
  ['.nums li:nth-child(4)', metric('TICS Radar', 'evenimente'), 'evenimente live, TICS Radar', 'liveEvents'],
  ['#despre', '17 ani', 'de software'],
  ['#clienti', String(clients.length), 'proiecte pentru clienți'],
];
const ledgerHtml = `<ol class="ledger reveal" id="ledger"><li class="ledger-head"><span>Până aici, pe scurt</span></li>${ledger.map(([at, value, label, live]) => `<li data-at="${at}"${live ? ` data-live="${live}"` : ''}><b>${value}</b><span>${label}</span></li>`).join('')}<li class="ledger-next"><b>Urmează</b><span>proiectul vostru</span></li></ol>`;
---
<Layout
  title="Andrei Năstase | Aplicații web, mobile și cofondator tehnic"
  description={`17 ani de software, ${products.length} produse proprii. Construiesc aplicații web și mobile și caut fondatori cu idei și clienți, pentru parteneriate pe termen lung.`}
>
  <section class="home-hero">
    <div class="hh-view">
    <div class="wrap">
      <div class="hh-copy">
      <h1>Aveți nevoie de o aplicație? Sau de cineva care să o construiască <span class="hot">alături de voi</span>?</h1>
      <p class="lead">Sunt senior full-stack, cu 17 ani de software și {products.length} produse proprii în spate. Vă spun sincer ce merită construit. Iar dacă ideea e bună și are clienți care o așteaptă, intru cofondator tehnic.</p>
      <div class="paths">
        <a class="go" href="#contact"><i></i><span>Programați apelul gratuit</span></a>
        <a class="go" href="/cofondator/"><i></i><span>Am o idee, caut cofondator</span></a>
      </div>
      <ul class="stats label">
        <li>17 ani de software</li>
        <li>{products.length} produse proprii</li>
        <li>{clients.length} proiecte pentru clienți</li>
        <li>Răspuns într-o zi lucrătoare</li>
      </ul>
      </div>
      <div class="hh-phones" aria-hidden="true">
        {hero.map(([file, layer]) => <span class={`hh-phone hh-${layer}`}><img src={`/shots/${file}.jpg`} alt="" decoding="async" draggable="false"></span>)}
      </div>
    </div>
    </div>
  </section>

  <div class="work">
    <section id="proiecte" aria-labelledby="work-title">
      <div class="wrap head">
        <div>
          <h2 id="work-title">Ce am construit</h2>
          <p>Produse proprii, ca fondator sau cofondator. La fiecare am făcut designul, codul și lansarea.</p>
        </div>
        <div class="ctrl" id="ctrl">
          <button id="prev" aria-label="Proiectul anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 5l-7 7 7 7"/></svg></button>
          <button id="toggle" aria-label="Oprește mișcarea" aria-pressed="false"><svg viewBox="0 0 24 24" fill="currentColor"><path id="toggle-path" d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg></button>
          <button id="next" aria-label="Proiectul următor"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 5l7 7-7 7"/></svg></button>
        </div>
      </div>
      <div class="stage" id="stage">
        {products.map(p => (
          <a class="item" href={p.url} target="_blank" rel="noopener">
            <span class="frame"><img src={`/shots/${p.file}.jpg`} alt={`Site-ul ${p.name} pe telefon`} width="780" height={p.h ?? 6000} loading="lazy" draggable="false"></span>
            <span class="cap"><span>{p.name}</span><span>{p.tag}</span>{p.stat && <em>{p.stat}</em>}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="wrap sub nums" aria-labelledby="nums-title">
      <h2 id="nums-title">Cifrele din spatele lor</h2>
      <ul>
        {numbers.map(n => (
          <li class="reveal">
            <div class="nums-name"><a href={n.url} target="_blank" rel="noopener">{n.name}</a>{n.note && <span>{n.note}</span>}</div>
            <dl>
              {n.metrics.map(m => (
                <div>
                  <dd data-count={m.value} data-dec={m.dec ?? 0} data-prefix={m.prefix ?? ''} data-suffix={m.suffix ?? ''} data-stat={m.key}>{format(m)}</dd>
                  <dt>{m.label}</dt>
                </div>
              ))}
            </dl>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section class="cof" id="cofondator" aria-labelledby="cof-title">
    <div class="wrap">
      <div class="cof-main">
        <p class="label kick"><i class="pulse"></i>Cel mult 2 fondatori noi în același timp</p>
        <h2 id="cof-title">Ai ideea și oameni care o așteaptă? Îți lipsește cine să construiască produsul.</h2>
        <p class="lead">Intru alături de tine ca și cofondator tehnic și pornim împreună o firmă nouă. Nu construiesc și plec: rămân pe termen lung și răspund eu de produs, ca tu să te ocupi de clienți și de vânzări.</p>
        <div class="paths">
          <a class="go" href="/cofondator/#idee"><i></i><span>Spune-mi ideea</span></a>
          <a class="go" href="/cofondator/"><i></i><span>Cum funcționează</span></a>
        </div>
      </div>
      <ul class="cof-deals">
        <li class="reveal"><span class="label">Doar parteneriat</span><strong>0 €</strong><p>Suport eu tot costul dezvoltării. Împărțim firma egal, 50/50.</p></li>
        <li class="reveal" data-delay="1"><span class="label">Preț redus și parteneriat</span><strong>de la 3.000 €</strong><p>Plătești o parte din cost, eu acopăr restul. Primesc o parte mai mică din firmă.</p></li>
      </ul>
    </div>
  </section>

  <section class="band" aria-hidden="true"><div class="band-track" id="band">{[0, 1, 2].map(() => <span>{skills.map(s => <b>{s}</b>)}</span>)}</div></section>

  <section class="about-new" id="despre" aria-labelledby="about-title">
    <div class="wrap">
      <div class="portrait reveal"><img src="/andrei.jpg" alt="Andrei Năstase" width="800" height="800" loading="lazy"></div>
      <div>
        <h2 id="about-title">Cine sunt</h2>
        <p class="lead">Sunt Andrei Năstase, din Ploiești. Scriu software de 17 ani, ca senior full-stack: frontend, backend și aplicații mobile. Pe lângă cod fac product design, animație și strategie de marketing, pentru că produsele mele au avut nevoie de toate astea.</p>
        <div class="know">
          <div class="reveal"><h3>Ce fac</h3><p>Construiesc produse de la zero, de la idee la lansare. Le fac pentru firme, pentru mine și, tot mai des, împreună cu fondatori din alte domenii.</p></div>
          <div class="reveal" data-delay="1"><h3>Ce știu</h3><p>Laravel, PHP, Vue.js, JavaScript, MySQL, PostgreSQL, WordPress, plăți cu Stripe, AWS, integrări AI și extensii de Chrome.</p></div>
          <div class="reveal" data-delay="2"><h3>La ce sunt bun</h3><p>Să spun ce nu merită construit. Să duc un produs până la clienți care plătesc. Să conduc echipe, ca CTO sau ca director de festival.</p></div>
        </div>
        <ul class="roles-mini">
          {roles.map(r => <li class="reveal"><span>{r.years}</span><b>{r.url ? <a href={r.url} target="_blank" rel="noopener">{r.name}</a> : r.name}</b><em>{r.role}</em></li>)}
        </ul>
        <div class="btn-row">
          {socials.map(([label, url]) => <a class="btn" href={url} target="_blank" rel="noopener">{label}</a>)}
        </div>
      </div>
    </div>
  </section>

  <section class="next-up" aria-labelledby="work-next">
    <div class="wrap">
      <h2 id="work-next">În lucru și de vânzare</h2>
      <div class="phones">
        {inWork.map(p => (
          <a class="phone" href={p.url} target={p.url && '_blank'} rel={p.url && 'noopener'}>
            {has(`work/${p.file}`)
              ? <span class="frame"><img src={`/shots/work/${p.file}.jpg`} alt={`Site-ul ${p.name} pe telefon`} width="780" height="1688" loading="lazy"></span>
              : <span class="frame is-empty">{p.name}</span>}
            <b>{p.name}</b>
            <span class="label">{p.status}</span>
            <p>{p.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="clients" id="clienti" aria-labelledby="clients-title">
    <div class="t-view">
      <div class="t-bar wrap">
        <div class="filters" id="filters" role="group" aria-label="Filtrează după domeniu">
          <button aria-pressed="true" data-cat="">Toate</button>
          {cats.map(c => <button aria-pressed="false" data-cat={c}>{c}</button>)}
        </div>
      </div>
      <div class="t-intro">
        <h2 id="clients-title">Lucrări pentru clienți</h2>
        <p>{list.length} de site-uri, din {cats.length} domenii. Derulați.</p>
      </div>
      <ul class="tunnel" id="tunnel">
        {list.map(c => (
          <li data-cat={c.cat} data-name={c.name} data-work={c.work}>
            {c.offline
              ? <div class="t-off"><img src={`/shots/clients/${c.file}.jpg`} alt={`Site-ul ${c.name}`} width="1280" height="800" loading="lazy" draggable="false"><span class="t-cap"><b>{c.name}</b>{c.work}</span></div>
              : <a href={c.url} target="_blank" rel="noopener"><img src={`/shots/clients/${c.file}.jpg`} alt={`Site-ul ${c.name}`} width="1280" height="800" loading="lazy" draggable="false"><span class="t-cap"><b>{c.name}</b>{c.work}</span></a>}
          </li>
        ))}
      </ul>
      <div class="t-now" aria-hidden="true"><b></b><span></span><i></i></div>
      <a class="t-skip" href="#servicii">Sari peste</a>
    </div>
  </section>
  {older.length > 0 && <p class="t-rest"><span class="wrap">Tot de la mine: {older.map(c => c.name).join(', ')}.</span></p>}

  <Fragment set:html={restA} />
  <Pricing />
  <Fragment set:html={restC} />
  <Process steps={steps} intro="De la primul apel la aplicația folosită de echipa voastră, știți mereu unde suntem." />
  <Fragment set:html={restD.replace('<!--ledger-->', ledgerHtml)} />

  <aside class="tally" id="tally" aria-label="Cifrele de până aici" hidden>
    <button class="tally-head" type="button" aria-expanded="false"><span>Până aici</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg></button>
    <button class="tally-x" type="button" aria-label="Ascunde sumarul"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    <ol></ol>
  </aside>

  <script>import '../scripts/hero.js'; import '../scripts/arc.js'; import '../scripts/clients.js'; import '../scripts/numbers.js'; import '../scripts/receipt.js';</script>
</Layout>
